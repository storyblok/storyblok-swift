{"kind":"article","primaryContentSections":[{"content":[{"anchor":"Getting-Started","text":"Getting Started","type":"heading","level":2},{"anchor":"Add-package-dependency","text":"Add package dependency","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Add the "},{"code":"StoryblokUI","type":"codeVoice"},{"type":"text","text":" library to your target, as described in "},{"identifier":"doc:\/\/StoryblokUI\/documentation\/StoryblokUI\/UserGuide#Add-package-dependency","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Make-your-block-library-a-View","text":"Make your block library a `View`","type":"heading","level":3},{"inlineContent":[{"code":"RichText","type":"codeVoice"},{"type":"text","text":" becomes a SwiftUI "},{"code":"View","type":"codeVoice"},{"type":"text","text":" only when its block library is itself a "},{"code":"View","type":"codeVoice"},{"type":"text","text":". Conform your "},{"identifier":"https:\/\/storyblok.github.io\/storyblok-swift\/documentation\/storyblokclient\/blocklibrary","isActive":true,"type":"reference"},{"type":"text","text":" to "},{"code":"View","type":"codeVoice"},{"type":"text","text":" so that embedded component blocks render alongside the standard rich-text nodes:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftUI","import StoryblokClient","","extension Content: View {","    var body: some View {","        switch self {","        case .article(let article): ArticleView(article: article)","        case .callout(let callout): CalloutView(callout: callout)","        case .unknown: EmptyView()","        }","    }","}"],"type":"codeListing"},{"content":[{"inlineContent":[{"type":"text","text":"Returning "},{"type":"codeVoice","code":"EmptyView()"},{"type":"text","text":" from the "},{"type":"codeVoice","code":"unknown"},{"type":"text","text":" case keeps unrecognised components from disrupting layout."}],"type":"paragraph"}],"name":"Tip","type":"aside","style":"tip"},{"anchor":"Render-rich-text","text":"Render rich text","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"With the conformance in place, import "},{"code":"StoryblokUI","type":"codeVoice"},{"type":"text","text":" and place a "},{"type":"codeVoice","code":"RichText"},{"type":"text","text":" value anywhere a "},{"type":"codeVoice","code":"View"},{"type":"text","text":" is expected:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftUI","import StoryblokClient","import StoryblokUI","","struct ArticleBody: View {","    let content: RichText<Content>","","    var body: some View {","        ScrollView {","            content","                .padding()","        }","    }","}"],"type":"codeListing"},{"anchor":"Built-in-rendering","text":"Built-in rendering","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Each node type renders with a default view designed to look reasonable out of the box:"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Node"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Default rendering"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Document"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"LazyVStack"},{"type":"text","text":" of its child nodes."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Paragraph"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Text"},{"type":"text","text":" with inline marks; a lone image paragraph renders as the image."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Heading"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Text"},{"type":"text","text":" sized by heading level ("},{"type":"codeVoice","code":"largeTitle"},{"type":"text","text":" … "},{"type":"codeVoice","code":"subheadline"},{"type":"text","text":")."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"AttributedString"},{"type":"text","text":" carrying its inline marks."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Bullet \/ Ordered list"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Indented rows with depth-aware bullets or numbers."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Blockquote"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A leading accent bar beside the quoted content."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Code block"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Monospaced "},{"type":"codeVoice","code":"Text"},{"type":"text","text":" on a rounded, tinted background."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Image"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"AsyncImage"},{"type":"text","text":" with loading and failure placeholders."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Table"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Grid"},{"type":"text","text":" with header and cell styling, honoring column spans."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Embedded block"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The component rendered through your block library’s ","type":"text"},{"type":"codeVoice","code":"View"},{"text":" conformance.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Emoji"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The emoji character."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Horizontal rule"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Divider"},{"type":"text","text":"."