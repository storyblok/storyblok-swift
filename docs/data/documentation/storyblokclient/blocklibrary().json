lokClient\/UserGuide"]},{"content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Each case maps to a Storyblok component: the case name is matched against the component’s"},{"type":"text","text":" "},{"type":"text","text":"technical name (override the mapping with a top-level "},{"type":"codeVoice","code":"CodingKeys"},{"type":"text","text":" enum). A case may carry"},{"type":"text","text":" "},{"type":"text","text":"either a single unlabeled nested-struct associated value (which decodes the whole content"},{"type":"text","text":" "},{"type":"text","text":"object) or labeled associated values (which decode individual fields). A parameterless"},{"type":"text","text":" "},{"type":"codeVoice","code":"case unknown"},{"type":"text","text":" acts as a catch-all so unrecognised components decode without throwing."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Applied to an "},{"type":"codeVoice","code":"enum"},{"type":"text","text":", this macro:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Adds a "},{"code":"relations","type":"codeVoice"},{"type":"text","text":" static property built from the enum’s case names and the labels of any"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/StoryblokClient\/documentation\/StoryblokClient\/Story"},{"type":"text","text":"-typed associated values (including "},{"type":"reference","isActive":true,"identifier":"doc:\/\/StoryblokClient\/documentation\/StoryblokClient\/Story"},{"type":"text","text":" fields of nested structs). The format"},{"type":"text","text":" "},{"type":"text","text":"is "},{"code":"componentName.fieldName","type":"codeVoice"},{"type":"text","text":" pairs joined by commas, sorted alphabetically, ready for use as"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"resolve_relations","type":"codeVoice"},{"type":"text","text":