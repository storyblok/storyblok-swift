,"identifiers":["doc:\/\/URLSessionExtension\/documentation\/URLSessionExtension\/Foundation\/URLSession\/CachedDataTaskPublisher\/Publisher-Implementations","doc:\/\/URLSessionExtension\/documentation\/URLSessionExtension\/Foundation\/URLSession\/CachedDataTaskPublisher\/Publisher-Implementations"]}],"seeAlsoSections":[{"anchor":"Showing-cached-responses-while-revalidating","title":"Showing cached responses while revalidating","generated":true,"identifiers":["doc:\/\/URLSessionExtension\/documentation\/URLSessionExtension\/Foundation\/URLSession\/cachedDataTaskPublisher(for:)-8dwfl","doc:\/\/URLSessionExtension\/documentation\/URLSessionExtension\/Foundation\/URLSession\/cachedDataTaskPublisher(for:)-403h6"]}],"identifier":{"url":"doc:\/\/URLSessionExtension\/documentation\/URLSessionExtension\/Foundation\/URLSession\/CachedDataTaskPublisher","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/urlsessionextension\/foundation\/urlsession\/cacheddatataskpublisher"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CachedDataTaskPublisher","kind":"identifier"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/URLSessionExtension\/documentation\/URLSessionExtension\/UserGuide"]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Create one with ","type":"text"},{"identifier":"doc:\/\/URLSessionExtension\/documentation\/URLSessionExtension\/Foundation\/URLSession\/cachedDataTaskPublisher(for:)-8dwfl","type":"reference","isActive":true},{"text":". It is","type":"text"},{"text":" ","type":"text"},{"text":"the stale-while-revalidate counterpart of","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/urlsession\/datataskpublisher","type":"reference","isActive":true},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"a view can show what it last received at once, then update when the request completes.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The cached response is read without touching the network. When the cache holds none, or","type":"text"},{"text":" ","type":"text"},{"text":"holds an error response, the publisher skips straight to the request: only a successful","type":"text"},{"text":" ","type":"text"},{"text":"response stands in for the one the request loads.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The request is then performed with its own cache policy. Transient failures — network"},{"type":"text","text":" "},{"type":"text","text":"errors and the error responses "},{"identifier":"doc:\/\/URLSessionExtension\/documentation\/URLSessionExtension\/Api\/ErrorResponseType\/recoverable","type":"reference","isActive":true},{"text":" covers — are retried","type":"text"},{"text":" ","type":"text"},{"text":"up to three times, and any error response then fails the publisher with a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/URLSessionExtension\/documentation\/URLSessionExtension\/Api\/ResponseError","type":"reference"},{"text":", as described in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/URLSessionExtension\/documentation\/URLSessionExtension\/UserGuide#Retrying-failed-requests","type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"When the request’s response has the same data and ","type":"text"},{"code":"total","type":"codeVoice"},{"text":" header as the cached one, it is","type":"text"},{"text":" ","type":"text"},{"text":"not published again. A paginated endpoint reports its element count in ","type":"text"},{"code":"total","type":"codeVoice"},{"text":", so a page","type":"text"},{"text":" ","type":"text"},{"text":"whose count changed is published even when its elements did not.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"A failure of the request ends the publisher after the cached response, if there was one, so a"},{"type":"text","text":" "},{"type":"text","text":"subscriber that keeps the last value received still has it."}],"type":"paragraph"}]}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/URLSessionExtension\/7Combine9PublisherP"]}],"sections":[],"abstract":[{"text":"A publisher that delivers the response the URL cache holds for a request, then the response","type":"text"},{"text":" ","type":"text"},{"text":"the request loads.","type":"text"}],"references":{"doc://URLSessionExtension/documentation/URLSessionExtension/Foundation/URLSession/CachedDataTaskPublisher/Failure":{"type":"topic","title":"URLSession.CachedDataTaskPublisher.Failure","role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Failure","kind":"identifier"}],"abstract":[],"url":"\/documentation\/urlsessionextension\/foundation\/urlsession\/cacheddatataskpublisher\/failure","identifier":"doc:\/\/URLSessionExtension\/documentation\/URLSessionExtension\/Foundation\/URLSession\/CachedDataTaskPublisher\/Failure"},"doc://URLSessionExtension/documentation/URLSessionExtension/Foundation/URLSession/CachedDataTaskPublisher/init(request:session:)":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"request"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation10URLRequestV","text":"URLRequest"},{"kind":"text","text":", "},{"kind":"externalParam","text":"session"},{"kind":"text","text":": "},{"kind":"t